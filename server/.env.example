# ============================================================
# ReguFlow Backend - Environment Variables
# ============================================================
# Copy file ini menjadi .env dan isi nilainya.

# Koneksi Neon PostgreSQL (dari dashboard Neon → Connection Details).
# Format: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Secret untuk menandatangani JWT access token (random string panjang).
# Generate dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Secret untuk refresh token (beda dengan access secret).
JWT_REFRESH_SECRET=

# Port server API (default 3000)
PORT=3000

# Frontend URL untuk CORS (default Vite dev server)
FRONTEND_URL=http://localhost:5173

# Direktori penyimpanan file dokumen upload (private, tidak di-serve statis)
UPLOAD_DIR=./storage/documents

# Ukuran maksimal upload dalam bytes (default 10MB)
MAX_UPLOAD_BYTES=10485760

# NODE_ENV: development | production
NODE_ENV=development
