# URL project Supabase Anda, contoh: https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Anon/public key Supabase (aman untuk frontend). Dapatkan di Dashboard > Settings > API.
VITE_SUPABASE_ANON_KEY=

# ============================================================
# KEY RAHASIA - JANGAN PERNAH DIMASUKKAN KE FRONTEND
# ============================================================
# Service role key hanya untuk server/backend/admin scripts (mis. seeding admin pertama).
# Jangan taruh di file ini, jangan commit, jangan expose ke browser.
# SUPABASE_SERVICE_ROLE_KEY=
