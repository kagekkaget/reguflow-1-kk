# ============================================================================
# ReguFlow - Environment variables FRONTEND
# ----------------------------------------------------------------------------
# Salin file ini menjadi `.env` di folder root.
# Secret server (database & JWT) ada di `server/.env.example` - JANGAN ditaruh
# di file ini karena semua nilai VITE_* ikut ter-bundle ke browser.
# ============================================================================

# URL API Express (backend di folder /server). Dev default: http://localhost:3000
VITE_API_URL=http://localhost:3000

# Catatan production:
# - Nilai ini dibaca saat `npm run build`, jadi ubah lalu build ulang.
# - Jika API berada di origin berbeda, tambahkan origin tersebut ke `connect-src`
#   pada CSP (vercel.json / _headers), atau proxy path /api agar tetap
#   same-origin.

