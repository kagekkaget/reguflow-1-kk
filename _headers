/*
  ReguFlow - Security headers (Netlify / Cloudflare Pages style)
  Letakkan file ini di root project; hosting akan menerapkannya.
*/

/*
  Content-Security-Policy:
  - default-src 'self' (hanya resource dari domain sendiri)
  - connect-src: izinkan API Supabase
  - style-src 'unsafe-inline' dibutuhkan oleh Tailwind (inline styles)
*/
/*
  /:*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://*.supabase.co; font-src 'self' data:;
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
